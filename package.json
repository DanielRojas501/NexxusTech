{
  "name": "nexxustech",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "typecheck:server": "tsc --noEmit -p ./tsconfig.server.json",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test:server": "cross-env NODE_ENV=test tsx --test server/tests/security.test.ts server/tests/streak.test.ts",
    "check": "npm run typecheck:server && npm run typecheck && npm run lint && npm run test:server && npm run build"
  },
