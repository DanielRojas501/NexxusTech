# ─────────────────────────────────────────────────────────────
#  FRONTEND (variables públicas: NUNCA pongas secretos con VITE_)
# ─────────────────────────────────────────────────────────────
# Déjala VACÍA si el frontend lo sirve este mismo Express (caso normal en Railway):
# la app usará /api del mismo dominio. Solo defínela si el frontend vive en OTRO dominio.
# VITE_API_BASE_URL=https://api.tudominio.com/api

# ─────────────────────────────────────────────────────────────
#  BACKEND
# ─────────────────────────────────────────────────────────────
PORT=3000

# URL pública de la app (se usa en enlaces de correo, Stripe y CORS). OBLIGATORIA en producción.
APP_URL=http://localhost:5173

# Orígenes extra permitidos por CORS, separados por coma (opcional).
# El propio APP_URL y el mismo origen que sirve la app ya están permitidos.
CORS_ORIGIN=

# OBLIGATORIO. Mínimo 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si falta o es el valor de ejemplo, el servidor NO arranca.
JWT_SECRET=

# Archivo JSON de datos. En producción apunta a un VOLUMEN PERSISTENTE (Railway: monta un
# volumen en /data y usa DATABASE_PATH=/data/database.json) o los datos se pierden en cada deploy.
DATABASE_PATH=./data/database.json

# Saltos de proxy confiables (Railway/Render/Fly = 1). Necesario para que el rate limit vea la IP real.
# TRUST_PROXY=1

# ── Stripe (opcional; si defines la llave secreta, en producción exige también webhook y precios) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ── Correo para restablecer contraseña (Resend). Sin esto /forgot-password responde 503 en producción ──
RESEND_API_KEY=
MAIL_FROM="NexxusTech <no-reply@tudominio.com>"

# ── Tutor IA "Profe Bot" (opcional) ──
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
